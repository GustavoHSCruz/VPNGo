{
    "version": "@VERSION@",
    "description": "Route selected applications through WireGuard VPN profiles.",
    "homepage": "https://github.com/@REPOSITORY@",
    "license": "Apache-2.0",
    "depends": [
        "python",
        "mihomo"
    ],
    "url": "https://github.com/@REPOSITORY@/releases/download/v@VERSION@/vpngo-@VERSION@-windows.zip",
    "hash": "@SHA256_WINDOWS_ZIP@",
    "extract_dir": "vpngo-@VERSION@-windows",
    "bin": [
        [
            "windows\\vpngo.cmd",
            "vpngo"
        ]
    ],
    "notes": "Windows app routing also requires ProxiFyre 2.6.4+ and Windows Packet Filter; see the explicit backend installation step: https://github.com/@REPOSITORY@/blob/v@VERSION@/docs/HOWTO.md#3-windows",
    "checkver": {
        "github": "https://github.com/@REPOSITORY@"
    },
    "autoupdate": {
        "url": "https://github.com/@REPOSITORY@/releases/download/v$version/vpngo-$version-windows.zip",
        "extract_dir": "vpngo-$version-windows",
        "hash": {
            "url": "$baseurl/SHA256SUMS"
        }
    }
}
