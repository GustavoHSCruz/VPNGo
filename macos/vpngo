#!/bin/sh
# vpngo for macOS. VPNGO_MIHOMO can point to a custom binary.
set -eu

# Follow the ~/.local/bin/vpngo link back to the installed launcher.
source=$0
while [ -L "$source" ]; do
    link=$(readlink "$source")
    case "$link" in
        /*) source=$link ;;
        *) source=$(dirname -- "$source")/$link ;;
    esac
done
project=$(CDPATH= cd -- "$(dirname -- "$source")/.." && pwd)
state="$HOME/.local/state/vpngo/mihomo"
python=${VPNGO_PYTHON:-python3}

if [ "$#" -eq 4 ] && [ "$1" = temp-wait ]; then
    process=$2
    session=$3
    launch=$4
    cleanup() { "$python" "$project/shared/managed.py" temp-cleanup "$process" "$session"; }
    trap cleanup 0
    "$python" "$project/shared/managed.py" temp-bind "$process" "$session" "$$"
    case "$launch" in
        *.app) open -W -a "$launch" ;;
        *) "$launch" ;;
    esac
    exit $?
fi

if [ "$#" -gt 0 ]; then
    case "$1" in
        profile|assign|start|stop|switch|status|on|off|policy|helper|version|help|--help|-h|--install-gui|group|app|update)
            exec "$python" "$project/shared/commands.py" "$@" ;;
    esac
fi

if [ "$#" -ge 3 ] && [ "$#" -le 4 ] && [ "$1" = --temp ]; then
    detached=0
    if [ "$#" -eq 4 ]; then
        case "$4" in -d|--detach) detached=1 ;; *) "$python" "$project/shared/commands.py" >&2; exit 2 ;; esac
    fi
    profile=$2
    application=$3
    resolved=$("$python" "$project/shared/managed.py" temp-resolve "$application")
    process=$(printf '%s' "$resolved" | "$python" -c 'import json,sys; print(json.load(sys.stdin)["process"])')
    if pgrep -u "$(id -u)" -x "$process" >/dev/null 2>&1; then
        printf '%s\n' "$process is already running; close it before a temporary VPN run." >&2
        exit 1
    fi
    app_json=$("$python" "$project/shared/managed.py" temp-prepare "$application" "$profile")
    process=$(printf '%s' "$app_json" | "$python" -c 'import json,sys; print(json.load(sys.stdin)["process"])')
    session=$(printf '%s' "$app_json" | "$python" -c 'import json,sys; print(json.load(sys.stdin)["session"])')
    launch=$(printf '%s' "$app_json" | "$python" -c 'import json,sys; print(json.load(sys.stdin)["launch"])')
    cleanup() { "$python" "$project/shared/managed.py" temp-cleanup "$process" "$session"; }
    trap cleanup 0
    mihomo=${VPNGO_MIHOMO:-$(command -v mihomo || true)}
    [ -n "$mihomo" ] && [ -x "$mihomo" ] || { printf '%s\n' 'mihomo executable not found.' >&2; exit 1; }
    if ! "$python" "$project/shared/control.py" "$process" status >/dev/null 2>&1; then
        sudo -v
        nohup sudo -n "$mihomo" -d "$state" -f "$state/config.yaml" \
            >> "$state/mihomo.log" 2>&1 < /dev/null &
        ready=0
        count=0
        while [ "$count" -lt 30 ]; do
            if "$python" "$project/shared/control.py" "$process" status >/dev/null 2>&1; then
                ready=1
                break
            fi
            sleep 1
            count=$((count + 1))
        done
        [ "$ready" -eq 1 ] || { printf '%s\n' "Mihomo did not start. See $state/mihomo.log" >&2; exit 1; }
    fi
    if [ "$detached" -eq 1 ]; then
        umask 077
        nohup "$source" temp-wait "$process" "$session" "$launch" >> "$state/temp.log" 2>&1 < /dev/null &
        worker=$!
        trap - 0
        printf '%s\n' "$application started through the VPN (PID $worker). You can close this terminal."
        exit 0
    fi
    "$python" "$project/shared/managed.py" temp-bind "$process" "$session" "$$"
    case "$launch" in
        *.app) open -W -a "$launch" ;;
        *) "$launch" ;;
    esac
    exit $?
fi

usage() {
    "$python" "$project/shared/commands.py" >&2
    exit 2
}

if [ "$#" -eq 2 ] && [ "$1" = config ]; then
    "$python" "$project/shared/apps.py" config "$2"
    exit
fi
if [ "$#" -eq 1 ] && [ "$1" = profiles ]; then
    "$python" "$project/shared/profiles.py" list
    exit
fi
if [ "$#" -ge 2 ] && [ "$#" -le 3 ] && [ "$1" = setup ]; then
    if [ "$#" -eq 3 ]; then
        "$python" "$project/shared/generate_mihomo.py" "$2" "$3"
    else
        "$python" "$project/shared/generate_mihomo.py" "$2"
    fi
    exit
fi
[ "$#" -ge 1 ] && [ "$#" -le 3 ] || usage
application=$1
action=${2:-start}
[ "$#" -lt 3 ] || [ "$action" = start ] || usage

case "$action" in
    start)
        app_json=$("$python" "$project/shared/managed.py" prepare "$application" "${3:-default}")
        launch=$(printf '%s' "$app_json" | "$python" -c 'import json,sys; print(json.load(sys.stdin)["launch"])')
        process=$(printf '%s' "$app_json" | "$python" -c 'import json,sys; print(json.load(sys.stdin)["process"])')
        mihomo=${VPNGO_MIHOMO:-$(command -v mihomo || true)}
        [ -n "$mihomo" ] && [ -x "$mihomo" ] || { printf '%s\n' 'mihomo executable not found.' >&2; exit 1; }
        if ! "$python" "$project/shared/control.py" "$application" status >/dev/null 2>&1; then
            sudo -v
            nohup sudo -n "$mihomo" -d "$state" -f "$state/config.yaml" \
                >> "$state/mihomo.log" 2>&1 < /dev/null &
            ready=0
            count=0
            while [ "$count" -lt 30 ]; do
                if "$python" "$project/shared/control.py" "$application" status >/dev/null 2>&1; then
                    ready=1
                    break
                fi
                sleep 1
                count=$((count + 1))
            done
            [ "$ready" -eq 1 ] || { printf '%s\n' "Mihomo did not start. See $state/mihomo.log" >&2; exit 1; }
        fi
        "$python" "$project/shared/control.py" "$application" on
        pkill -u "$(id -u)" -x "$process" 2>/dev/null || true
        helper=${process%.*}
        pkill -u "$(id -u)" -x "$helper Helper.*" 2>/dev/null || true
        "$python" "$project/shared/control.py" "$application" reconnect >/dev/null
        sleep 1
        case "$launch" in
            *.app) open -a "$launch" ;;
            *) nohup "$launch" >> "$state/app.log" 2>&1 < /dev/null & ;;
        esac
        printf '%s\n' "$application started through the VPN."
        ;;
    on|off|status)
        "$python" "$project/shared/control.py" "$application" "$action"
        ;;
    stop)
        app_json=$("$python" "$project/shared/managed.py" inspect "$application")
        if [ "$app_json" = null ]; then
            printf '%s\n' "$application: already stopped."
            exit 0
        fi
        process=$(printf '%s' "$app_json" | "$python" -c 'import json,sys; print(json.load(sys.stdin)["process"])')
        case "$process" in
            python|python3|sh|bash|zsh|sudo|vopono|systemd|init|launchd|Finder|WindowServer|Dock|loginwindow)
                printf '%s\n' "Refusing to close shared process '$process'." >&2
                exit 1 ;;
        esac
        process_pattern=$(printf '%s' "$process" | "$python" -c 'import re,sys; print(re.escape(sys.stdin.read()))')
        block_failed=0
        "$python" "$project/shared/control.py" "$application" block || block_failed=1
        pkill -TERM -u "$(id -u)" -x "$process_pattern" 2>/dev/null || true
        helper_pattern=$(printf '%s' "${process%.*}" | "$python" -c 'import re,sys; print(re.escape(sys.stdin.read()))')
        pkill -TERM -u "$(id -u)" -x "$helper_pattern Helper.*" 2>/dev/null || true
        helper_names=$(printf '%s' "$app_json" | "$python" -c 'import json,sys,pathlib; print("\n".join(pathlib.Path(p).name for p in json.load(sys.stdin).get("helpers", [])))')
        printf '%s\n' "$helper_names" | while IFS= read -r helper_name; do
            [ -n "$helper_name" ] || continue
            case "$helper_name" in
                python|python3|sh|bash|zsh|sudo|vopono|systemd|init|launchd|Finder|WindowServer|Dock|loginwindow)
                    continue ;;
            esac
            helper_name_pattern=$(printf '%s' "$helper_name" | "$python" -c 'import re,sys; print(re.escape(sys.stdin.read()))')
            pkill -TERM -u "$(id -u)" -x "$helper_name_pattern" 2>/dev/null || true
        done
        count=0
        while pgrep -u "$(id -u)" -x "$process_pattern" >/dev/null 2>&1 && [ "$count" -lt 6 ]; do
            sleep 1
            count=$((count + 1))
        done
        pkill -KILL -u "$(id -u)" -x "$process_pattern" 2>/dev/null || true
        if pgrep -u "$(id -u)" -x "$process_pattern" >/dev/null 2>&1 || [ "$block_failed" -ne 0 ]; then
            printf '%s\n' "$application: stop incomplete; the route remains blocked if Mihomo accepted it." >&2
            exit 1
        fi
        if printf '%s' "$app_json" | "$python" -c 'import json,sys; sys.exit(0 if json.load(sys.stdin).get("temporary") else 1)'; then
            session=$(printf '%s' "$app_json" | "$python" -c 'import json,sys; print(json.load(sys.stdin)["session"])')
            "$python" "$project/shared/managed.py" temp-cleanup "$process" "$session"
            printf '%s\n' "$application: application closed; temporary Mihomo route removed."
        else
            printf '%s\n' "$application: application closed; its Mihomo route is blocked. Other applications stay connected."
        fi
        ;;
    *) usage ;;
esac
